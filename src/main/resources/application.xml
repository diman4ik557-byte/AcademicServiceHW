<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                             http://www.springframework.org/schema/beans/spring-beans.xsd
                             http://www.springframework.org/schema/context
                             http://www.springframework.org/schema/context/spring-context-4.0.xsd">

    <context:property-placeholder location="classpath:application.properties"/>

    <bean class="by.step.bfpp.CustomBeanFactoryPostProcessor"/>
    <bean class="by.step.bfpp.VerifyPropertyBeanFactoryPostProcessor"/>

    <bean id="dateFormatter" class="java.text.SimpleDateFormat">
        <constructor-arg value="${app.date.format}"/>
    </bean>

    <bean id="studentRepository" class="by.step.repository.impl.StudentRepositoryJSON">
        <property name="data" value="${data.students}"/>
        <property name="dF" ref="dateFormatter"/>
    </bean>

    <bean id="gradeRepository" class="by.step.repository.impl.GradeRepositoryJSON">
        <property name="data" value="${data.grades}"/>
        <property name="dF" ref="dateFormatter"/>
    </bean>

    <bean id="academicService" class="by.step.service.impl.AcademicServiceImpl">
        <constructor-arg ref="studentRepository"/>
        <constructor-arg ref="gradeRepository"/>
    </bean>

    <bean id="academicController" class="by.step.controller.AcademicController">
        <constructor-arg ref="academicService"/>
    </bean>

    <bean id="mainController" class="by.step.controller.MainController">
        <constructor-arg ref="academicController"/>
    </bean>

</beans>